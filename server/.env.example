# Paste your Neon connection string here (Neon console -> your project -> Connection Details).
# It already includes ?sslmode=require, which is what Neon needs.
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/techprep?sslmode=require"

# Set to "false" only if connecting to a local Postgres without SSL.
PGSSL=true

JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
